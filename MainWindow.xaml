<Window x:Class="ProjetoPVB02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetoPVB02"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
	<Grid>
		<Label x:Name="orien" Content="Insira os dados numéricos, um por linha:" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="364" Height="38" FontSize="20"/>
		<TextBox x:Name="dados" HorizontalAlignment="Center" Margin="0,53,0,0" TextWrapping="Wrap" Text="a" VerticalAlignment="Top" Width="232" AcceptsReturn="True"/>
		<Button x:Name="botao" Content="Calcular Estatísticas" HorizontalAlignment="Center" Margin="0,341,0,0" VerticalAlignment="Top" Width="232" Click="Button_Click" Height="41"/>
		<Label x:Name="qtd" Content="Resposta" HorizontalAlignment="Center" Margin="0,152,0,0" VerticalAlignment="Top" Width="232"/>
		<Label x:Name="min" Content="Resposta" HorizontalAlignment="Center" Margin="0,170,0,0" VerticalAlignment="Top" Width="232"/>
		<Label x:Name="max" Content="Resposta" HorizontalAlignment="Center" Margin="0,188,0,0" VerticalAlignment="Top" Width="232"/>
		<Label x:Name="var" Content="Resposta" HorizontalAlignment="Center" Margin="0,228,0,0" VerticalAlignment="Top" Width="232"/>
		<Label x:Name="des" Content="Resposta" HorizontalAlignment="Center" Margin="0,247,0,0" VerticalAlignment="Top" Width="232"/>
		<Label x:Name="med" Content="Resposta" HorizontalAlignment="Center" VerticalAlignment="Top" Width="232" Margin="0,210,0,0"/>

	</Grid>
</Window>
